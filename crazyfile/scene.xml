<mujoco model="CF2 scene">
  <!-- 引入 Crazyflie 模型及其 assets / defaults -->
  <include file="cf2.xml"/>

  <option timestep="0.01"/>
  <statistic center="0 0 0.1" extent="0.2" meansize=".05"/>

  <visual>
    <headlight diffuse="0.6 0.6 0.6" ambient="0.3 0.3 0.3" specular="0 0 0"/>
    <rgba haze="0.15 0.25 0.35 1"/>
    <global azimuth="-20" elevation="-20" ellipsoidinertia="true"/>
  </visual>

  <asset>
    <texture type="skybox" builtin="gradient"
             rgb1="0.3 0.5 0.7" rgb2="0 0 0"
             width="512" height="3072"/>
    <texture type="2d" name="groundplane" builtin="checker" mark="edge"
             rgb1="0.2 0.3 0.4" rgb2="0.1 0.2 0.3"
             markrgb="0.8 0.8 0.8" width="300" height="300"/>
    <material name="groundplane" texture="groundplane"
              texuniform="true" texrepeat="5 5" reflectance="0.2"/>

    <!-- 目标机用的红色机体材质 -->
    <material name="target_red" rgba="1 0 0 1"/>

    <!-- 安全区域材质（半透明） -->
    <material name="safe_hunter" rgba="0 1 0 0.1"/>
    <material name="safe_target" rgba="1 0 0 0.1"/>

    <!-- 障碍物材质：灰色半透明球体 -->
    <material name="obstacle_mat" rgba="0.5 0.5 0.5 0.4"/>
  </asset>

  <worldbody>
    <!-- 场景中心：(2 * 0.035/0.03, 2 * 0.035/0.03) ≈ (2.3333, 2.3333) -->
    <!-- 俯视相机：在场景中心上方 2m，朝正下方 -->
    <camera name="world_camera"
            pos="2.3333333 2.3333333 2.0"
            euler="0 -90 0"/>

    <light pos="0 0 1.5" dir="0 0 -1" directional="true"/>
    <geom name="floor" size="0 0 0.05" type="plane" material="groundplane"/>

    <!-- 上边界：薄的深灰色墙 -->
    <geom name="boundary_top" type="box"
          pos="2.3333333 4.6666667 0.25"
          size="2.3333333 0.005 0.25"
          rgba="0.5 0.5 0.5 0.4"/>

    <!-- 下边界：薄的深灰色墙 -->
    <geom name="boundary_bottom" type="box"
          pos="2.3333333 0 0.25"
          size="2.3333333 0.005 0.25"
          rgba="0.5 0.5 0.5 0.4"/>

    <!-- 右边界：薄的深灰色墙 -->
    <geom name="boundary_right" type="box"
          pos="4.6666667 2.3333333 0.25"
          size="0.005 2.3333333 0.25"
          rgba="0.5 0.5 0.5 0.4"/>

    <!-- 左边界：薄的深灰色墙 -->
    <geom name="boundary_left" type="box"
          pos="0 2.3333333 0.25"
          size="0.005 2.3333333 0.25"
          rgba="0.5 0.5 0.5 0.4"/>

    <!--
      说明：
      - cf2.xml 里本身有一个 body name="cf2" 的 Crazyflie 机体；
        我们现在不再把它当 hunter0，而是自己定义 hunter0~hunter3。
      - hunter0~hunter3、target_cf 都使用 childclass="cf2" 复用 Crazyflie 的几何和材质。
      - 每个 hunter / target 再挂一个球形安全区域。
      - 障碍物 obs0~obs9 的位置和半径由 Python 程序动态更新。
    -->

    <!-- Hunter 0（第一架追逐者） -->
    <body name="hunter0" pos="0.3 0.0 0.1" childclass="cf2">
      <joint name="hunter0_root" type="free"/>
      <inertial pos="0 0 0" mass="0.033"
